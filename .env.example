# WhatsApp Cloud API, used by api/enquiry.ts. Server-only: never prefix these with VITE_.
# Copy to .env for local testing; set the same names in Vercel for the live site.
# See README → "WhatsApp enquiry form".
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCOUNT_ID=
WHATSAPP_ALERT_TO=
WHATSAPP_ALERT_TEMPLATE=new_enquiry_alert
WHATSAPP_TEMPLATE_LANGUAGE=en
